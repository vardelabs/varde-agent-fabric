#!/usr/bin/env bash
# Dispatch one bounded task through its resolved local or remote route.
#
# This public entry point owns transport-neutral validation and invokes a
# backend through a narrow environment contract. Deployment policy, network
# services, credentials, and model routing belong to the caller or a private
# adapter, not this repository.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
BACKENDS_DIR="$SELF_DIR/backends"
MAX_TASK_BYTES="${DISPATCH_MAX_TASK_BYTES:-120000}"
# Keep in sync with contracts/implement_contracts.py:MAX_TASK_BYTES.
MAX_IMPLEMENT_TASK_BYTES=16384

usage() {
  cat >&2 <<'EOF'
Usage: varde-agent-dispatch (--model ID --routes FILE | --harness NAME) --kind KIND --task TEXT --workdir DIR [options]

Options:
  --harness NAME   Backend name, codex or opencode
  --kind KIND      Work contract, review or implement (passthrough is legacy spelling; behavior is harness-specific)
  --task TEXT      Bounded task prompt
  --workdir DIR    Existing absolute directory (use a Git worktree for isolated review)
  --diff FILE      Review input, required for review kind
  --model ID       Explicit model identifier
  --routes FILE    Model route configuration, required with --model
  --output FILE    Output file, default is a private temporary file
  --repository NAME  Repository metadata for remote reviews
  --pull-request N   Pull request number for remote reviews
  --base-sha SHA     Review base commit SHA
  --head-sha SHA     Review head commit SHA
  --correlation-id ID  Request correlation identifier
  --path PATH       Changed path, repeat for remote reviews
  --help           Show this help
EOF
}

fail() { printf 'varde-agent-dispatch: %s\n' "$1" >&2; exit "${2:-2}"; }

harness=""; kind=""; task=""; workdir=""; diff=""; model=""; routes=""; route_target=""; route_harness_overridden=""; route_fallback_policy=""; route_fallback_harness=""; route_fallback_target=""; output=""
repository=""; pull_request=""; base_sha=""; head_sha=""; correlation_id=""; paths=()
model_from_cli=0; routes_from_cli=0; review_args_supplied=0
while (($#)); do
  case "$1" in
    --harness) [[ $# -ge 2 ]] || fail '--harness requires a value'; harness="$2"; shift 2 ;;
    --kind) [[ $# -ge 2 ]] || fail '--kind requires a value'; kind="$2"; shift 2 ;;
    --task) [[ $# -ge 2 ]] || fail '--task requires a value'; task="$2"; shift 2 ;;
    --workdir) [[ $# -ge 2 ]] || fail '--workdir requires a value'; workdir="$2"; shift 2 ;;
    --diff) [[ $# -ge 2 ]] || fail '--diff requires a value'; diff="$2"; review_args_supplied=1; shift 2 ;;
    --model) [[ $# -ge 2 ]] || fail '--model requires a value'; model="$2"; model_from_cli=1; shift 2 ;;
    --routes) [[ $# -ge 2 ]] || fail '--routes requires a value'; routes="$2"; routes_from_cli=1; shift 2 ;;
    --output) [[ $# -ge 2 ]] || fail '--output requires a value'; output="$2"; shift 2 ;;
    --repository) [[ $# -ge 2 ]] || fail '--repository requires a value'; repository="$2"; shift 2 ;;
    --pull-request) [[ $# -ge 2 ]] || fail '--pull-request requires a value'; pull_request="$2"; review_args_supplied=1; shift 2 ;;
    --base-sha) [[ $# -ge 2 ]] || fail '--base-sha requires a value'; base_sha="$2"; review_args_supplied=1; shift 2 ;;
    --head-sha) [[ $# -ge 2 ]] || fail '--head-sha requires a value'; head_sha="$2"; review_args_supplied=1; shift 2 ;;
    --correlation-id) [[ $# -ge 2 ]] || fail '--correlation-id requires a value'; correlation_id="$2"; shift 2 ;;
    --path) [[ $# -ge 2 ]] || fail '--path requires a value'; paths+=("$2"); shift 2 ;;
    --help) usage; exit 0 ;;
    *) fail "unknown option: $1" ;;
  esac
done

model="${model:-${DISPATCH_MODEL:-}}"
routes_requested="$routes"
if [[ -z "$routes_requested" && "$model_from_cli" -eq 1 ]]; then
  routes_requested="${DISPATCH_ROUTES_FILE:-}"
fi
[[ "$routes_from_cli" -eq 0 || -n "$model" ]] || fail '--routes requires --model' 2
[[ -n "$kind" ]] || fail '--kind is required'

if [[ "$model_from_cli" -eq 1 || -n "$routes_requested" ]]; then
  routes="$routes_requested"
  [[ -n "$model" ]] || fail 'a model is required when route configuration is used' 2
  [[ -n "$routes" && "$routes" = /* && -f "$routes" ]] || fail '--routes must name a route configuration file when --model is used' 2
  resolved_route="$(PYTHONPATH="$SELF_DIR/../.." python3 - "$routes" "$model" "$kind" "$harness" <<'PY'
import json
import sys
from dispatch.route_registry import RouteConfigError, RouteRegistry

try:
    with open(sys.argv[1], encoding="utf-8") as stream:
        registry = RouteRegistry.from_dict(json.load(stream))
    route = registry.resolve(sys.argv[2], sys.argv[3], harness=sys.argv[4] or None)
except (OSError, ValueError, json.JSONDecodeError, RouteConfigError) as exc:
    print(f"route resolution failed: {exc}", file=sys.stderr)
    raise SystemExit(3)
print(f"{route.harness}\t{route.model}\t{route.target}\t{str(route.harness_overridden).lower()}\t{route.fallback.policy}\t{route.fallback.harness or ''}\t{route.fallback.target or ''}")
PY
  )" || fail 'route resolution failed; see the validation error above' 3
  IFS=$'\t' read -r harness model route_target route_harness_overridden route_fallback_policy route_fallback_harness route_fallback_target <<< "$resolved_route"
fi

[[ -n "$harness" ]] || fail '--harness is required when --model is not used'
[[ -n "$task" ]] || fail '--task is required'
[[ -n "$workdir" ]] || fail '--workdir is required'
[[ "$workdir" = /* && "$workdir" != "/" && -d "$workdir" ]] || fail '--workdir must be an existing absolute directory other than /'
[[ "$workdir" != *$'\n'* && "$workdir" != *$'\r'* ]] || fail '--workdir contains an invalid path'

case "$kind" in
  implement|passthrough) [[ -z "$diff" ]] || fail '--diff is only valid with --kind review' ;;
  review) [[ -n "$diff" && -f "$diff" ]] || fail '--diff must name a regular file for review' ;;
  *) fail "unsupported kind: $kind" 3 ;;
esac

backend="$BACKENDS_DIR/$harness.sh"
if [[ "$route_target" != "remote" ]]; then
  [[ "$harness" != */* && -f "$backend" && -x "$backend" ]] || fail "unsupported harness: $harness" 3
fi

if [[ "$route_target" == "remote" ]]; then
  [[ "$kind" == "review" || "$kind" == "implement" ]] || fail 'remote routes require review or implement kind' 3
  [[ -n "$repository" && -n "$correlation_id" ]] || fail 'remote route requires repository and correlation ID' 2
  ((${#paths[@]} > 0)) || fail 'remote route requires at least one explicit --path' 2
  if [[ "$kind" == "review" ]]; then
    [[ -n "$pull_request" && -n "$base_sha" && -n "$head_sha" ]] || fail 'remote reviews require explicit pull request, base SHA, and head SHA' 2
    [[ "$pull_request" =~ ^[1-9][0-9]*$ ]] || fail '--pull-request must be a positive integer' 2
  else
    [[ ( "$harness" == "codex" || "$harness" == "opencode" ) && "${route_fallback_policy:-none}" == "none" ]] || fail 'remote implement requires supported harness and fallback policy none' 3
    [[ "$review_args_supplied" -eq 0 ]] || fail 'remote implement rejects PR, SHA and diff arguments' 2
    implement_task_bytes="$(LC_ALL=C printf '%s' "$task" | wc -c)"
    (( implement_task_bytes <= MAX_IMPLEMENT_TASK_BYTES )) || fail "implement task exceeds ${MAX_IMPLEMENT_TASK_BYTES} bytes"
  fi
  timeout_seconds="${DISPATCH_TIMEOUT_SECONDS:-300}"
  [[ "$timeout_seconds" =~ ^[1-9][0-9]{0,2}$ ]] || fail 'DISPATCH_TIMEOUT_SECONDS must be from 1 to 900 for remote routes' 2
  (( timeout_seconds <= 900 )) || fail 'DISPATCH_TIMEOUT_SECONDS must be from 1 to 900 for remote routes' 2
fi

if ! [[ "$MAX_TASK_BYTES" =~ ^[1-9][0-9]*$ ]]; then fail 'DISPATCH_MAX_TASK_BYTES must be a positive integer'; fi
if (( $(LC_ALL=C printf '%s' "$task" | wc -c) > MAX_TASK_BYTES )); then fail 'task exceeds DISPATCH_MAX_TASK_BYTES'; fi

diff_bytes=0
if [[ -n "$diff" ]]; then
  diff="$(readlink -f -- "$diff")"
  diff_bytes="$(wc -c < "$diff" | tr -d '[:space:]')"
  [[ "$diff_bytes" =~ ^[0-9]+$ ]] || fail 'could not determine diff size'
  if (( diff_bytes > MAX_TASK_BYTES )); then fail 'diff exceeds DISPATCH_MAX_TASK_BYTES'; fi
  if (( diff_bytes + $(LC_ALL=C printf '%s' "$task" | wc -c) + 40 > MAX_TASK_BYTES )); then
    fail 'combined task and diff exceed DISPATCH_MAX_TASK_BYTES'
  fi
  export DISPATCH_DIFF="$diff"
else
  unset DISPATCH_DIFF
fi

requested_output=""
backend_output=""
if [[ -z "$output" ]]; then
  output="$(mktemp "${TMPDIR:-/tmp}/agent-dispatch-output.XXXXXX")"
  backend_output="$output"
else
  [[ "$output" = /* && "$output" != *$'\n'* && "$output" != *$'\r'* ]] || fail '--output must be an absolute path without newlines'
  output_parent="$(dirname -- "$output")"
  [[ -d "$output_parent" ]] || fail 'output parent does not exist'
  output_parent="$(readlink -f -- "$output_parent")"
  [[ "$output_parent" != *$'\n'* && "$output_parent" != *$'\r'* ]] || fail 'output parent contains an invalid path'
  output_name="$(basename -- "$output")"
  [[ "$output_name" != "." && "$output_name" != ".." && "$output_name" != *'/'* ]] || fail 'output filename is invalid'
  requested_output="$output_parent/$output_name"
  backend_output="$(mktemp "$output_parent/.agent-dispatch-backend.XXXXXX")"
  trap 'rm -f -- "$backend_output"' EXIT
  output="$requested_output"
fi

export DISPATCH_TASK="$task" DISPATCH_WORKDIR="$workdir" DISPATCH_OUTPUT="$backend_output" DISPATCH_KIND="$kind"
if [[ -n "$model" ]]; then
  export DISPATCH_MODEL="$model"
elif [[ -n "${DISPATCH_MODEL:-}" ]]; then
  export DISPATCH_MODEL
else
  unset DISPATCH_MODEL
fi

if [[ "$route_target" == "remote" ]]; then
  remote_args=(
    --output "$backend_output" --local-backend "$backend" --harness "$harness" --target "$route_target"
    --fallback-policy "${route_fallback_policy:-none}" --model "$model"
    --workdir "$workdir" --repository "$repository" --correlation-id "$correlation_id"
    --kind "$kind" --task "$task" --timeout-seconds "$timeout_seconds"
  )
  if [[ "$kind" == "review" ]]; then
    remote_args+=(--pull-request "$pull_request" --base-sha "$base_sha" --head-sha "$head_sha")
  fi
  [[ -n "$diff" ]] && remote_args+=(--diff "$diff")
  for path in "${paths[@]}"; do remote_args+=(--path "$path"); done
  if [[ -z "${DISPATCH_GATEWAY_URL:-}" || -z "${DISPATCH_GATEWAY_TOKEN:-}" ]]; then
    fail 'remote route requires DISPATCH_GATEWAY_URL and DISPATCH_GATEWAY_TOKEN' 4
  fi
  remote_status=0
  remote_environment=(
    "PATH=${PATH:-/usr/bin:/bin}"
    "HOME=${HOME:-}"
    "TMPDIR=${TMPDIR:-/tmp}"
    "DISPATCH_GATEWAY_URL=$DISPATCH_GATEWAY_URL"
    "DISPATCH_GATEWAY_TOKEN=$DISPATCH_GATEWAY_TOKEN"
    "DISPATCH_GATEWAY_CA_FILE=${DISPATCH_GATEWAY_CA_FILE:-}"
    "PYTHONPATH=$SELF_DIR/../.."
  )
  if [[ "${route_fallback_policy:-none}" == "remote-unavailable" \
    && "${route_fallback_harness:-}" == "opencode" && "${route_fallback_target:-}" == "local" ]]; then
    if [[ -n "${DISPATCH_OPENCODE_HOME:-}" ]]; then
      remote_environment+=("DISPATCH_OPENCODE_HOME=$DISPATCH_OPENCODE_HOME")
    fi
  fi
  env -i "${remote_environment[@]}" python3 "$SELF_DIR/../remote_runner.py" "${remote_args[@]}" || remote_status=$?
  [[ "$remote_status" -eq 0 || ( "$kind" == "implement" && "$remote_status" -eq 6 ) ]] || exit "$remote_status"
else
sandbox="${DISPATCH_CODEX_SANDBOX:-}"
route_target_arg=()
route_metadata_args=()
if [[ -n "$route_target" ]]; then
  route_target_arg=("DISPATCH_TARGET=$route_target")
  route_metadata_args=(
    "DISPATCH_HARNESS_OVERRIDDEN=$route_harness_overridden"
    "DISPATCH_FALLBACK_POLICY=$route_fallback_policy"
    "DISPATCH_FALLBACK_HARNESS=$route_fallback_harness"
    "DISPATCH_FALLBACK_TARGET=$route_fallback_target"
  )
fi

# Deliberately pass a small, explicit environment. No caller credential or
# provider configuration is inherited by the backend. Build this as an array
# so paths and task values cannot split or expand into extra env arguments.
backend_env=(
  "PATH=${PATH:-/usr/bin:/bin}"
  "HOME=${HOME:-}"
  "TMPDIR=${TMPDIR:-/tmp}"
  "DISPATCH_TASK=$DISPATCH_TASK"
  "DISPATCH_WORKDIR=$DISPATCH_WORKDIR"
  "DISPATCH_OUTPUT=$DISPATCH_OUTPUT"
  "DISPATCH_KIND=$DISPATCH_KIND"
)
[[ -n "${DISPATCH_OPENCODE_HOME:-}" ]] && backend_env+=("DISPATCH_OPENCODE_HOME=$DISPATCH_OPENCODE_HOME")
[[ -n "${DISPATCH_OPENCODE_ALLOW_WRITE:-}" ]] && backend_env+=("DISPATCH_OPENCODE_ALLOW_WRITE=$DISPATCH_OPENCODE_ALLOW_WRITE")
[[ -n "${DISPATCH_DIFF:-}" ]] && backend_env+=("DISPATCH_DIFF=$DISPATCH_DIFF")
[[ -n "${DISPATCH_MODEL:-}" ]] && backend_env+=("DISPATCH_MODEL=$DISPATCH_MODEL")
if ((${#route_target_arg[@]})); then backend_env+=("${route_target_arg[@]}"); fi
if ((${#route_metadata_args[@]})); then backend_env+=("${route_metadata_args[@]}"); fi
[[ -n "$sandbox" ]] && backend_env+=("DISPATCH_CODEX_SANDBOX=$sandbox")
env -i "${backend_env[@]}" "$backend"
fi

[[ -s "$backend_output" ]] || fail 'backend completed without a non-empty output artifact' 5
if [[ -n "$requested_output" ]]; then
  python3 - "$backend_output" "$requested_output" <<'PY'
import os
import pathlib
import sys

source, target = map(pathlib.Path, sys.argv[1:])
parent = target.parent
name = target.name
parent_fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW
    fd = os.open(name, flags, 0o600, dir_fd=parent_fd)
    try:
        with source.open("rb") as src, os.fdopen(fd, "wb") as dst:
            fd = -1
            while True:
                block = src.read(1024 * 1024)
                if not block:
                    break
                dst.write(block)
    finally:
        if fd != -1:
            os.close(fd)
finally:
    os.close(parent_fd)
source.unlink()
PY
fi
printf '%s\n' "$output"
exit "${remote_status:-0}"
