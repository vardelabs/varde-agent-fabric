#!/usr/bin/env bash
# Dispatch one bounded task to a local backend.
#
# This public entry point owns transport-neutral validation and invokes a
# backend through a narrow environment contract. Deployment policy, network
# services, credentials, and model routing belong to the caller or a private
# adapter, not this repository.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
BACKENDS_DIR="$SELF_DIR/backends"
MAX_TASK_BYTES="${DISPATCH_MAX_TASK_BYTES:-120000}"

usage() {
  cat >&2 <<'EOF'
Usage: varde-agent-dispatch (--model ID --routes FILE | --harness NAME) --kind KIND --task TEXT --workdir DIR [options]

Options:
  --harness NAME   Backend name, currently codex
  --kind KIND      Work contract, currently passthrough or review
  --task TEXT      Bounded task prompt
  --workdir DIR    Existing absolute working directory
  --diff FILE      Review input, required for review kind
  --model ID       Explicit model identifier
  --routes FILE    Model route configuration, required with --model
  --output FILE    Output file, default is a private temporary file
  --help           Show this help
EOF
}

fail() { printf 'varde-agent-dispatch: %s\n' "$1" >&2; exit "${2:-2}"; }

harness=""; kind=""; task=""; workdir=""; diff=""; model=""; routes=""; route_target=""; output=""
while (($#)); do
  case "$1" in
    --harness) [[ $# -ge 2 ]] || fail '--harness requires a value'; harness="$2"; shift 2 ;;
    --kind) [[ $# -ge 2 ]] || fail '--kind requires a value'; kind="$2"; shift 2 ;;
    --task) [[ $# -ge 2 ]] || fail '--task requires a value'; task="$2"; shift 2 ;;
    --workdir) [[ $# -ge 2 ]] || fail '--workdir requires a value'; workdir="$2"; shift 2 ;;
    --diff) [[ $# -ge 2 ]] || fail '--diff requires a value'; diff="$2"; shift 2 ;;
    --model) [[ $# -ge 2 ]] || fail '--model requires a value'; model="$2"; shift 2 ;;
    --routes) [[ $# -ge 2 ]] || fail '--routes requires a value'; routes="$2"; shift 2 ;;
    --output) [[ $# -ge 2 ]] || fail '--output requires a value'; output="$2"; shift 2 ;;
    --help) usage; exit 0 ;;
    *) fail "unknown option: $1" ;;
  esac
done

model="${model:-${DISPATCH_MODEL:-}}"
[[ -n "$kind" ]] || fail '--kind is required'

if [[ -n "$model" ]]; then
  routes="${routes:-${DISPATCH_ROUTES_FILE:-}}"
  [[ -n "$routes" && "$routes" = /* && -f "$routes" ]] || fail '--routes must name a route configuration file when --model is used' 2
  resolved_route="$(PYTHONPATH="$SELF_DIR/../.." python3 - "$routes" "$model" "$kind" "$harness" <<'PY'
import json
import sys
from dispatch.route_registry import RouteConfigError, RouteRegistry

try:
    with open(sys.argv[1], encoding="utf-8") as stream:
        registry = RouteRegistry.from_dict(json.load(stream))
    route = registry.resolve(sys.argv[2], sys.argv[3], harness=sys.argv[4] or None)
except (OSError, ValueError, json.JSONDecodeError, RouteConfigError) as exc:
    print(f"route resolution failed: {exc}", file=sys.stderr)
    raise SystemExit(3)
print(f"{route.harness}\t{route.model}\t{route.target}")
PY
  )" || fail 'route resolution failed; see the validation error above' 3
  IFS=$'\t' read -r harness model route_target <<< "$resolved_route"
fi

[[ -n "$harness" ]] || fail '--harness is required when --model is not used'
[[ -n "$kind" ]] || fail '--kind is required'
[[ -n "$task" ]] || fail '--task is required'
[[ -n "$workdir" ]] || fail '--workdir is required'
[[ "$workdir" = /* && "$workdir" != "/" && -d "$workdir" ]] || fail '--workdir must be an existing absolute directory other than /'
[[ "$workdir" != *$'\n'* && "$workdir" != *$'\r'* ]] || fail '--workdir contains an invalid path'

case "$kind" in
  passthrough) [[ -z "$diff" ]] || fail '--diff is only valid with --kind review' ;;
  review) [[ -n "$diff" && -f "$diff" ]] || fail '--diff must name a regular file for review' ;;
  *) fail "unsupported kind: $kind" 3 ;;
esac

backend="$BACKENDS_DIR/$harness.sh"
[[ "$harness" != */* && -f "$backend" && -x "$backend" ]] || fail "unsupported harness: $harness" 3

if ! [[ "$MAX_TASK_BYTES" =~ ^[1-9][0-9]*$ ]]; then fail 'DISPATCH_MAX_TASK_BYTES must be a positive integer'; fi
if (( $(LC_ALL=C printf '%s' "$task" | wc -c) > MAX_TASK_BYTES )); then fail 'task exceeds DISPATCH_MAX_TASK_BYTES'; fi

diff_bytes=0
if [[ -n "$diff" ]]; then
  diff="$(readlink -f -- "$diff")"
  diff_bytes="$(wc -c < "$diff")"
  [[ "$diff_bytes" =~ ^[0-9]+$ ]] || fail 'could not determine diff size'
  if (( diff_bytes > MAX_TASK_BYTES )); then fail 'diff exceeds DISPATCH_MAX_TASK_BYTES'; fi
  if (( diff_bytes + $(LC_ALL=C printf '%s' "$task" | wc -c) + 40 > MAX_TASK_BYTES )); then
    fail 'combined task and diff exceed DISPATCH_MAX_TASK_BYTES'
  fi
  export DISPATCH_DIFF="$diff"
else
  unset DISPATCH_DIFF
fi

requested_output=""
backend_output=""
if [[ -z "$output" ]]; then
  output="$(mktemp "${TMPDIR:-/tmp}/agent-dispatch-output.XXXXXX")"
  backend_output="$output"
else
  [[ "$output" = /* && "$output" != *$'\n'* && "$output" != *$'\r'* ]] || fail '--output must be an absolute path without newlines'
  output_parent="$(dirname -- "$output")"
  [[ -d "$output_parent" ]] || fail 'output parent does not exist'
  output_parent="$(readlink -f -- "$output_parent")"
  [[ "$output_parent" != *$'\n'* && "$output_parent" != *$'\r'* ]] || fail 'output parent contains an invalid path'
  output_name="$(basename -- "$output")"
  [[ "$output_name" != "." && "$output_name" != ".." && "$output_name" != *'/'* ]] || fail 'output filename is invalid'
  requested_output="$output_parent/$output_name"
  backend_output="$(mktemp "$output_parent/.agent-dispatch-backend.XXXXXX")"
  trap 'rm -f -- "$backend_output"' EXIT
  output="$requested_output"
fi

export DISPATCH_TASK="$task" DISPATCH_WORKDIR="$workdir" DISPATCH_OUTPUT="$backend_output"
if [[ -n "$model" ]]; then
  export DISPATCH_MODEL="$model"
elif [[ -n "${DISPATCH_MODEL:-}" ]]; then
  export DISPATCH_MODEL
else
  unset DISPATCH_MODEL
fi
sandbox="${DISPATCH_CODEX_SANDBOX:-}"
route_target_arg=()
if [[ -n "$route_target" ]]; then
  route_target_arg=("DISPATCH_TARGET=$route_target")
fi

# Deliberately pass a small, explicit environment. No caller credential or
# provider configuration is inherited by the backend.
env -i \
  PATH="${PATH:-/usr/bin:/bin}" \
  HOME="${HOME:-}" \
  TMPDIR="${TMPDIR:-/tmp}" \
  DISPATCH_TASK="$DISPATCH_TASK" \
  DISPATCH_WORKDIR="$DISPATCH_WORKDIR" \
  DISPATCH_OUTPUT="$DISPATCH_OUTPUT" \
  ${DISPATCH_DIFF:+DISPATCH_DIFF="$DISPATCH_DIFF"} \
  ${DISPATCH_MODEL:+DISPATCH_MODEL="$DISPATCH_MODEL"} \
  "${route_target_arg[@]}" \
  ${sandbox:+DISPATCH_CODEX_SANDBOX="$sandbox"} \
  "$backend"

[[ -s "$backend_output" ]] || fail 'backend completed without a non-empty output artifact' 5
if [[ -n "$requested_output" ]]; then
  python3 - "$backend_output" "$requested_output" <<'PY'
import os
import pathlib
import sys

source, target = map(pathlib.Path, sys.argv[1:])
parent = target.parent
name = target.name
parent_fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW
    fd = os.open(name, flags, 0o600, dir_fd=parent_fd)
    try:
        with source.open("rb") as src, os.fdopen(fd, "wb") as dst:
            fd = -1
            while True:
                block = src.read(1024 * 1024)
                if not block:
                    break
                dst.write(block)
    finally:
        if fd != -1:
            os.close(fd)
finally:
    os.close(parent_fd)
source.unlink()
PY
fi
printf '%s\n' "$output"
