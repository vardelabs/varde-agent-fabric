*.gguf
*.safetensors
*.onnx
*.pt
*.ckpt
*.bin
*.pem
*.key
*.crt
*.p12
*.pfx
# Root deployment and runtime state. Component state is scoped below.
/models/
/weights/
/logs/
/audit/
/runtime/
/sockets/
/private-overlay
/private-overlay.*
# Declared dispatch runtime state.
/dispatch/audit/
/dispatch/runtime/
/dispatch/sockets/
/dispatch/logs/
/dispatch/weights/
/dispatch/private-overlay
/dispatch/private-overlay.*
# Declared inference runtime state.
/inference/audit/
/inference/runtime/
/inference/sockets/
/inference/logs/
/inference/weights/
/inference/private-overlay
/inference/private-overlay.*
# Evaluation deployment overlay. Synthetic fixture directories remain public.
/eval/private-overlay
/eval/private-overlay.*
*.sock
*.log
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
